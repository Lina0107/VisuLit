# Copy to .env on VPS before docker compose up

# Required backend
AITUNNEL_API_KEY=replace_with_real_key
AITUNNEL_BASE_URL=https://neuroapi.host/v1/
# Text model (chat/completions) — NOT for images. Used for:
#   Prepare book (cast from full text), GPT quote pick, GPT quote audit.
# Budget:     gpt-4o-mini      — cheapest; ok for audit, weaker on full-book Prepare
# Balanced:   gpt-4.1-mini     — recommended upgrade for quote/cast quality (~2× mini)
#             gpt-5-mini       — similar tier, good JSON
# Quality:    gpt-4.1          — if Prepare still misses characters on long novels
# Do NOT use gpt-image / GPT Image 1|2 here — those are IMAGE_MODEL only.
AITUNNEL_MODEL=gpt-4.1-mini

# Domain + SSL (Caddy)
DOMAIN=visulit.com
CADDY_EMAIL=you@example.com

# Image generation (NeuroAPI /images/generations) — "Nano Banana" family:
#   gemini-3-pro-image-preview   — Pro (~5.7₽/img): лучше слушает длинные промпты и цитаты; для VisuLit по умолчанию
#   gemini-3.1-flash-image       — Flash (~3.1₽/img): быстрее/дешевле; слабее на сложных правилах (кровь, «не актёр»)
#   gemini-3.1-flash-image-preview — если gateway требует -preview суффикс (проверьте в кабинете NeuroAPI)
IMAGE_MODEL=gemini-3-pro-image-preview
IMAGE_SIZE=1024x1536
# If your image API accepts a reference image as base64 on /images/generations, set the JSON key name here (provider-specific).
# Example values seen in some gateways: reference_images, image, input_image
IMAGE_REFERENCE_BASE64_FIELD=

# Public site URL (Open Graph / metadata)
NEXT_PUBLIC_SITE_URL=https://visulit.com

# Public support email (shown in UI)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@visulit.com

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2TBVVWWD2S
